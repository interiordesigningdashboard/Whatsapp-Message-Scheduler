<%- include('partials/header', { title: payment ? 'Edit payment reminder' : 'Add payment reminder' }) %>

<h1><%= payment ? 'Edit ' + payment.title : 'Add payment reminder' %></h1>

<form method="post" action="<%= payment ? '/payments/' + payment.id : '/payments' %>" class="card form" id="pay-form">
  <label>Title
    <input type="text" name="title" value="<%= form.title %>" required maxlength="100" placeholder="Car EMI, LIC premium…" autofocus>
  </label>

  <h2>Who to remind</h2>
  <p class="muted">Each person gets their own private message, with <code>{name}</code> replaced by their name.</p>
  <% if (contacts.length) { %>
    <label>Add from your WhatsApp contacts
      <input type="search" id="contact-pick" list="contact-list" placeholder="Start typing a name or number, then pick…" autocomplete="off">
      <datalist id="contact-list">
        <% contacts.forEach((c) => { %><option value="<%= c.name %> · +<%= c.phone %>"></option><% }) %>
      </datalist>
    </label>
  <% } %>

  <div id="people">
    <% const rows = form.people.length ? form.people : [{ name: '', phoneInput: '' }]; %>
    <% rows.forEach((r) => { %>
      <div class="person-row">
        <input type="text" name="recipient_name" value="<%= r.name %>" placeholder="Name" maxlength="100" aria-label="Name">
        <input type="tel" name="recipient_phone" value="<%= r.phoneInput %>" placeholder="98765 43210" aria-label="WhatsApp number">
        <button type="button" class="btn btn-secondary remove-person" title="Remove this person">✕</button>
      </div>
    <% }) %>
  </div>
  <button type="button" class="btn btn-secondary" id="add-person">+ Add person</button>
  <p class="muted">10-digit numbers get +91 automatically. For other countries start with + and the country code.
    <% if (!contacts.length) { %>To pick from your contacts, load them on the <a href="/groups">Groups &amp; contacts</a> page.<% } %></p>

  <template id="person-template">
    <div class="person-row">
      <input type="text" name="recipient_name" placeholder="Name" maxlength="100" aria-label="Name">
      <input type="tel" name="recipient_phone" placeholder="98765 43210" aria-label="WhatsApp number">
      <button type="button" class="btn btn-secondary remove-person" title="Remove this person">✕</button>
    </div>
  </template>

  <h2>Payment</h2>
  <div class="row">
    <label>Amount in ₹ (optional)
      <input type="text" name="amount" value="<%= form.amount %>" inputmode="decimal" placeholder="5000">
    </label>
    <label>First due date
      <input type="date" name="first_due_date" value="<%= form.first_due_date %>" required>
    </label>
  </div>

  <fieldset class="groups-picker">
    <legend>Repeats</legend>
    <label class="check"><input type="radio" name="repeat" value="monthly" <%= form.repeat === 'monthly' ? 'checked' : '' %>> Every month</label>
    <label class="check"><input type="radio" name="repeat" value="every_n" <%= form.repeat === 'every_n' ? 'checked' : '' %>>
      Every <input type="number" name="every_n" min="1" max="120" value="<%= form.every_n %>" class="tiny"> months (3 = quarterly, 6 = half-yearly)</label>
    <label class="check"><input type="radio" name="repeat" value="yearly" <%= form.repeat === 'yearly' ? 'checked' : '' %>> Every year</label>
    <p class="muted">The due day is taken from the first due date. If a month is shorter (e.g. the 31st in February), the last day of that month is used.</p>
  </fieldset>

  <div class="row">
    <label>Start reminding this many days before
      <input type="number" name="remind_days_before" min="0" max="30" value="<%= form.remind_days_before %>" required>
    </label>
    <label>Send time (India time)
      <input type="time" name="send_time" value="<%= form.send_time %>" required>
    </label>
  </div>
  <p class="muted">A reminder goes out every day from that many days before, up to and including the due date. 0 = only on the due date.</p>

  <div class="row">
    <label>Stop after this many payments (optional)
      <input type="number" name="end_count" min="1" value="<%= form.end_count %>" placeholder="e.g. 24">
    </label>
    <label>…or stop after this date (optional)
      <input type="date" name="end_date" value="<%= form.end_date %>">
    </label>
  </div>
  <p class="muted">Leave both empty to repeat until you pause or delete it (e.g. insurance).</p>

  <h2>Message</h2>
  <label>Reminder text
    <textarea name="message" rows="4" maxlength="2000" required><%= form.message %></textarea>
  </label>
  <p class="muted">Filled in automatically: <% placeholders.forEach((p) => { %><code>{<%= p %>}</code> <% }) %>
    · <code>{days_left}</code> becomes "in 2 days", "tomorrow" or "today".</p>
  <div class="preview-box">
    <div class="muted">Preview for the first person, first reminder:</div>
    <div id="preview-first" class="bubble"></div>
    <div class="muted">Preview, on the due date:</div>
    <div id="preview-last" class="bubble"></div>
  </div>

  <label class="check">
    <input type="checkbox" name="active" value="1" <%= form.active ? 'checked' : '' %>>
    Active (untick to pause without deleting)
  </label>

  <div class="buttons">
    <button class="btn" type="submit">Save</button>
    <a href="/payments" class="btn btn-secondary">Cancel</a>
  </div>
</form>

<% if (payment) { %>
<form method="post" action="/payments/<%= payment.id %>/delete" class="danger-zone"
      onsubmit="return confirm('Delete this payment reminder? This cannot be undone.')">
  <button class="btn btn-danger" type="submit">Delete this payment reminder</button>
</form>
<% } %>

<script>
  const form = document.getElementById('pay-form');
  const people = document.getElementById('people');

  function addPerson(name, phone) {
    // Reuse an empty row if there is one, otherwise add a new row.
    let row = [...people.querySelectorAll('.person-row')].find((r) =>
      !r.querySelector('[name=recipient_name]').value && !r.querySelector('[name=recipient_phone]').value);
    if (!row) {
      row = document.getElementById('person-template').content.firstElementChild.cloneNode(true);
      people.appendChild(row);
    }
    row.querySelector('[name=recipient_name]').value = name || '';
    row.querySelector('[name=recipient_phone]').value = phone || '';
    if (!name) row.querySelector('[name=recipient_name]').focus();
    updatePreview();
  }

  document.getElementById('add-person').addEventListener('click', () => addPerson('', ''));
  people.addEventListener('click', (e) => {
    if (!e.target.classList.contains('remove-person')) return;
    const rows = people.querySelectorAll('.person-row');
    if (rows.length > 1) e.target.closest('.person-row').remove();
    else rows[0].querySelectorAll('input').forEach((i) => { i.value = ''; });
    updatePreview();
  });

  const pick = document.getElementById('contact-pick');
  if (pick) {
    pick.addEventListener('input', () => {
      const m = /^(.*) · (\+\d+)$/.exec(pick.value);
      if (!m) return;
      const already = [...people.querySelectorAll('[name=recipient_phone]')].some((i) => i.value.replace(/\D/g, '') === m[2].replace(/\D/g, ''));
      if (!already) addPerson(m[1], m[2]);
      pick.value = '';
      pick.blur();
    });
  }

  let timer;
  async function updatePreview() {
    clearTimeout(timer);
    timer = setTimeout(async () => {
      const body = {};
      ['title', 'amount', 'message', 'first_due_date', 'remind_days_before'].forEach((k) => { body[k] = form[k].value; });
      const firstName = people.querySelector('[name=recipient_name]');
      body.person_name = firstName ? firstName.value : '';
      try {
        const res = await fetch('/payments/preview', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        const j = await res.json();
        document.getElementById('preview-first').textContent = j.text;
        document.getElementById('preview-last').textContent = j.lastDay;
      } catch (e) { /* ignore */ }
    }, 250);
  }
  form.addEventListener('input', updatePreview);
  updatePreview();
</script>

<%- include('partials/footer') %>
