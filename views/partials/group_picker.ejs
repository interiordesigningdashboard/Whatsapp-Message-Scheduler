<%# params: allGroups, groupIds (selected) %>
<fieldset class="groups-picker">
  <legend>Send to these groups</legend>
  <% if (!allGroups.length) { %>
    <p class="muted">No groups loaded yet. Go to <a href="/groups">Groups</a> and click <strong>Load groups from WhatsApp</strong>.</p>
  <% } else { %>
    <input type="search" class="group-search" placeholder="Search groups…" oninput="filterGroups(this)">
    <div class="group-list">
      <% allGroups.forEach((g) => { %>
        <label class="group-item" data-name="<%= g.name.toLowerCase() %>">
          <input type="checkbox" name="groups" value="<%= g.group_id %>" <%= groupIds.includes(g.group_id) ? 'checked' : '' %>>
          <%= g.name %>
          <% if (g.admins_only) { %><span class="tag tag-warn" title="Only admins can post in this group">admins only</span><% } %>
        </label>
      <% }) %>
    </div>
  <% } %>
  <% const known = new Set(allGroups.map((g) => g.group_id));
     const unknown = groupIds.filter((id) => !known.has(id)); %>
  <% unknown.forEach((id) => { %>
    <label class="group-item">
      <input type="checkbox" name="groups" value="<%= id %>" checked>
      <span class="muted">Group no longer in your list (<%= id %>)</span>
    </label>
  <% }) %>
</fieldset>
<script>
  function filterGroups(input) {
    const q = input.value.trim().toLowerCase();
    input.closest('fieldset').querySelectorAll('.group-item[data-name]').forEach((el) => {
      el.hidden = q && !el.dataset.name.includes(q);
    });
  }
</script>
