<%- include('partials/header', { title: 'One-off messages' }) %>

<div class="page-head">
  <h1>One-off messages</h1>
  <a class="btn" href="/messages/new">+ Schedule a message</a>
</div>

<section class="card">
  <% if (!rows.length) { %>
    <p class="muted">No messages scheduled.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Send at</th><th>Title</th><th>Groups</th><th>Status</th><th></th></tr></thead>
      <tbody>
      <% rows.forEach((m) => { %>
        <tr class="<%= m.status === 'pending' ? '' : 'inactive' %>">
          <td><%= t.prettyDateTime(t.parse(m.send_at)) %></td>
          <td>
            <strong><%= m.title %></strong>
            <% if (m.caption) { %><br><span class="muted clip"><%= m.caption %></span><% } %>
          </td>
          <td><%= m.groupIds.length %></td>
          <td>
            <% if (m.status === 'pending') { %><span class="tag tag-ok">scheduled</span>
            <% } else if (m.status === 'cancelled') { %><span class="tag">cancelled</span>
            <% } else { %><a class="tag" href="/history?q=<%= encodeURIComponent(m.title) %>">sent <%= m.sentCount %>/<%= m.logCount %></a><% } %>
          </td>
          <td class="actions">
            <% if (m.status === 'pending') { %>
              <a href="/messages/<%= m.id %>/edit">Edit</a>
              <form method="post" action="/messages/<%= m.id %>/test" class="inline"><button class="link" type="submit">Test to me</button></form>
              <form method="post" action="/messages/<%= m.id %>/cancel" class="inline" onsubmit="return confirm('Cancel this message?')"><button class="link" type="submit">Cancel</button></form>
            <% } else { %>
              <form method="post" action="/messages/<%= m.id %>/delete" class="inline" onsubmit="return confirm('Delete from the list?')"><button class="link" type="submit">Delete</button></form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<%- include('partials/footer') %>
