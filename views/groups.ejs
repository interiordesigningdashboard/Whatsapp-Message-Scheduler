<%- include('partials/header', { title: 'Groups & contacts' }) %>

<h1>Groups &amp; contacts</h1>

<section class="card">
  <form method="post" action="/groups/sync" class="inline">
    <button class="btn" type="submit" <%= waReady ? '' : 'disabled' %>>Load groups from WhatsApp</button>
  </form>
  <% if (!waReady) { %><span class="muted">Connect WhatsApp on the <a href="/">Status</a> page first.</span><% } %>
  <p class="muted">Loads every group you are a member of. Click again after joining or leaving a group.</p>
</section>

<section class="card">
  <% if (!groups.length) { %>
    <p class="muted">No groups loaded yet.</p>
  <% } else { %>
    <p class="muted"><%= groups.length %> groups, last loaded <%= groups[0].last_synced_at %>.</p>
    <table>
      <thead><tr><th>Name</th><th>Members</th><th></th></tr></thead>
      <tbody>
      <% groups.forEach((g) => { %>
        <tr>
          <td><%= g.name %></td>
          <td><%= g.participants_count ?? '' %></td>
          <td><% if (g.admins_only) { %><span class="tag tag-warn">only admins can post</span><% } %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<h2>Contacts</h2>
<section class="card">
  <form method="post" action="/contacts/sync" class="inline">
    <button class="btn" type="submit" <%= waReady ? '' : 'disabled' %>>Load contacts from WhatsApp</button>
  </form>
  <p class="muted">Used to pick a person on the Payments form. Only contacts saved in your phone are loaded. You can always type a number instead.</p>
  <% if (contacts.length) { %>
    <p class="muted"><%= contacts.length %> contacts, last loaded <%= contacts[0].last_synced_at %>.</p>
    <details>
      <summary>Show contacts</summary>
      <table>
        <thead><tr><th>Name</th><th>Number</th></tr></thead>
        <tbody>
        <% contacts.forEach((c) => { %><tr><td><%= c.name %></td><td>+<%= c.phone %></td></tr><% }) %>
        </tbody>
      </table>
    </details>
  <% } %>
</section>

<%- include('partials/footer') %>
